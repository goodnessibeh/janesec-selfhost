# Copy to .env and fill in. Only JWT_SIGNING_KEY is strictly required.

# Required — signs session JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SIGNING_KEY=

# Optional — Fernet key encrypting secrets at rest. Leave empty on a single
# node (one is generated and persisted on the state volume). Generate one for
# multi-replica setups with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Optional — host port the war room is published on (defaults to 8080).
# PORT=8080

# Optional — use an external Postgres instead of the bundled one.
# JANESEC_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/janesec
